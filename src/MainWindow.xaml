<Window x:Class="SnipFlow.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:editor="clr-namespace:SnipFlow.Editor" xmlns:ui="clr-namespace:SnipFlow.Services" Style="{StaticResource AppWindow}" Title="SnipFlow" Icon="Assets/SnipFlow-v2.png" Width="440" Height="300" MinWidth="440" MinHeight="300" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" AllowDrop="True" Drop="ImageDropped" PreviewKeyDown="WindowKeyDown" Closing="WindowClosing">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" /></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="68" /><RowDefinition Height="*" /><RowDefinition Height="32" /></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleDrag">
        <Grid Margin="20,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="Assets/SnipFlow-v2.png" Width="40" Height="40" Margin="0,0,10,0" />
            <TextBlock Text="SnipFlow" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="HeaderCapture" Click="CaptureClick" Style="{StaticResource Primary}" Padding="16,9" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" Margin="0,0,7,0" Foreground="#082722" /><TextBlock Text="{ui:Tr '新截圖'}" Foreground="#082722" /></StackPanel></Button>
            <Button x:Name="CompactButton" Content="▣" FontSize="16" Padding="0" Width="38" Height="34" Click="CompactClick" ToolTip="{ui:Tr '小型面板'}" />
            <Button Content="─" Padding="0" Width="38" Height="34" Click="MinimizeClick" ToolTip="{ui:Tr '最小化'}" />
            <Button x:Name="MaximizeButton" Content="□" Padding="0" Width="38" Height="34" Click="MaximizeClick" ToolTip="{ui:Tr '最大化／還原'}" />
            <Button Content="×" FontSize="21" Padding="0" Width="38" Height="34" Click="HideClick" ToolTip="{ui:Tr '隱藏至系統匣'}" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" x:Name="Workspace" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition /><ColumnDefinition Width="236" x:Name="HistoryColumn" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <DockPanel Margin="8,16,8,10">
            <DockPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="6,9" /></Style></DockPanel.Resources>
            <StackPanel DockPanel.Dock="Top">
              <Button Click="CaptureClick" ToolTip="{ui:Tr '框選截圖'}" Margin="0,0,0,8"><StackPanel><TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="{ui:Tr '截圖'}" FontSize="10" Margin="0,7,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
              <Button Click="ScrollClick" ToolTip="{ui:Tr '長頁捲動截圖'}" Margin="0,0,0,8"><StackPanel><TextBlock Text="&#xE8CB;" FontFamily="Segoe Fluent Icons" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="{ui:Tr '長截圖'}" FontSize="10" Margin="0,7,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
              <Button Click="RecordClick" ToolTip="{ui:Tr '螢幕錄影'}" Margin="0,0,0,8"><StackPanel><TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="{ui:Tr '錄影'}" FontSize="10" Margin="0,7,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
              <Button Click="OpenClick" ToolTip="{ui:Tr '開啟圖片'}"><StackPanel><TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons" FontSize="20" HorizontalAlignment="Center" /><TextBlock Text="{ui:Tr '開啟'}" FontSize="10" Margin="0,7,0,0" HorizontalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom"><Button Click="SettingsClick" ToolTip="{ui:Tr '設定'}"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="20" /></Button><Button Click="ExitClick" ToolTip="{ui:Tr '結束程式'}"><TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="18" /></Button></StackPanel>
            <Border />
          </DockPanel>
        </Border>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition Height="42" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Border Background="#111925" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,8">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CopyButton" Content="{ui:Tr '複製'}" Click="CopyClick" ToolTip="Ctrl + C" Margin="0,0,6,0" />
                <Button x:Name="SaveButton" Content="{ui:Tr '儲存'}" Click="SaveClick" Background="{StaticResource Raised}" ToolTip="Ctrl + S" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" x:Name="ToolButtons">
                <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,3" /><Setter Property="MinWidth" Value="34" /></Style></StackPanel.Resources>
                <Button Tag="Select" Click="ToolClick" ToolTip="{ui:Tr '選取／移動 (V)'}"><TextBlock Text="&#xE7C9;" FontFamily="Segoe Fluent Icons" /></Button>
                <Button Tag="Arrow" Click="ToolClick" ToolTip="{ui:Tr '箭頭 (A)'}" Content="↗" FontSize="20" />
                <Button Tag="Rectangle" Click="ToolClick" ToolTip="{ui:Tr '矩形 (R)'}" Content="□" FontSize="21" />
                <Button Tag="Ellipse" Click="ToolClick" ToolTip="{ui:Tr '橢圓 (E)'}" Content="○" FontSize="21" />
                <Button Tag="Pen" Click="ToolClick" ToolTip="{ui:Tr '畫筆 (P)'}"><TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons" /></Button>
                <Button Tag="Highlight" Click="ToolClick" ToolTip="{ui:Tr '螢光筆 (H)'}"><TextBlock Text="&#xE7E6;" FontFamily="Segoe Fluent Icons" /></Button>
                <Button Tag="Text" Click="ToolClick" ToolTip="{ui:Tr '文字 (T)'}" Content="T" FontWeight="Bold" />
                <Button Tag="Mosaic" Click="ToolClick" ToolTip="{ui:Tr '馬賽克 (M)'}" Content="▦" FontSize="19" />
                <Border Width="1" Height="22" Background="{StaticResource Line}" Margin="6,0" />
                <Button x:Name="UndoButton" Content="↶" FontSize="20" Click="UndoClick" ToolTip="{ui:Tr '復原 · Ctrl + Z'}" /><Button x:Name="RedoButton" Content="↷" FontSize="20" Click="RedoClick" ToolTip="{ui:Tr '重做 · Ctrl + Y'}" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Border Grid.Row="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="18,5">
              <Button DockPanel.Dock="Right" x:Name="OcrButton" Content="{ui:Tr '辨識文字  OCR'}" Click="OcrClick" Padding="10,4" Foreground="{StaticResource Accent}" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ToolLabel" Text="{ui:Tr '畫筆'}" Foreground="{StaticResource Muted}" Margin="0,0,14,0" VerticalAlignment="Center" />
                <StackPanel x:Name="ColorButtons" Orientation="Horizontal" Margin="0,0,14,0">
                  <Button Tag="#111827" Click="ColorClick" Style="{StaticResource ColorSwatch}" Background="#111827" ToolTip="{ui:Tr '黑色'}" />
                  <Button Tag="#63D5C5" Click="ColorClick" Style="{StaticResource ColorSwatch}" Background="#63D5C5" ToolTip="{ui:Tr '青綠'}" />
                  <Button Tag="#FF646C" Click="ColorClick" Style="{StaticResource ColorSwatch}" Background="#FF646C" ToolTip="{ui:Tr '紅色'}" />
                  <Button Tag="#FFCC6A" Click="ColorClick" Style="{StaticResource ColorSwatch}" Background="#FFCC6A" ToolTip="{ui:Tr '黃色'}" />
                  <Button Tag="#FFFFFF" Click="ColorClick" Style="{StaticResource ColorSwatch}" Background="White" ToolTip="{ui:Tr '白色'}" />
                </StackPanel>
                <StackPanel x:Name="WidthProperties" Orientation="Horizontal"><TextBlock Text="{ui:Tr '粗細'}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" /><Slider x:Name="WidthSlider" Minimum="1" Maximum="32" Value="4" Width="90" VerticalAlignment="Center" ValueChanged="StrokeChanged" Thumb.DragStarted="PropertyDragStarted" Thumb.DragCompleted="PropertyDragCompleted" /></StackPanel>
                <StackPanel x:Name="TextProperties" Orientation="Horizontal" Visibility="Collapsed"><TextBlock Text="{ui:Tr '字級'}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBox x:Name="TextSizeBox" Text="26" Width="58" Padding="6,3" TextAlignment="Center" VerticalContentAlignment="Center" LostKeyboardFocus="TextSizeChanged" PreviewKeyDown="TextSizeKeyDown" ToolTip="{ui:Tr '文字大小（12–240 px）'}" /></StackPanel>
              </StackPanel>
            </DockPanel>
          </Border>
          <editor:EditorView Grid.Row="2" x:Name="Editor" />
          <Grid Grid.Row="2" x:Name="EmptyState" Background="{StaticResource Bg}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="35">
              <Image Source="Assets/SnipFlow-v2.png" Width="96" Height="96" HorizontalAlignment="Center" Margin="0,0,0,20" />
              <Button Style="{StaticResource Primary}" Content="{ui:Tr '框選截圖'}" Click="CaptureClick" Width="180" Padding="16,13" HorizontalAlignment="Center" />
              <TextBlock x:Name="HotkeyHint" Text="Ctrl + Alt + S" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,16,0,18" />
              <Button Content="{ui:Tr '開啟圖片'}" Click="OpenClick" Width="180" BorderThickness="1" />
              <TextBlock Text="Ctrl + O ／ Ctrl + V" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
          </Grid>
          <Border Grid.Row="3" x:Name="UpdateBanner" Visibility="Collapsed" Background="#173C38" Padding="14,9"><DockPanel><Button Content="{ui:Tr '重新啟動更新'}" DockPanel.Dock="Right" Click="ApplyUpdateClick" Padding="10,4" Style="{StaticResource Primary}" /><TextBlock Text="{ui:Tr '新版本已下載。完成編輯後即可更新。'}" VerticalAlignment="Center" Foreground="#A9EAE0" /></DockPanel></Border>
        </Grid>
        <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="54" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <DockPanel Margin="16,0"><TextBlock Text="{ui:Tr '最近截圖'}" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock x:Name="HistoryCount" Text="0" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" /></DockPanel>
            <ListBox x:Name="HistoryList" Grid.Row="1" Background="Transparent" Foreground="{StaticResource Ink}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="HistorySelected" Padding="10,0">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#111925" Padding="8"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource Raised}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate><StackPanel><Border Background="#0C111B" CornerRadius="4" ClipToBounds="True"><Image Source="{Binding Thumbnail}" Height="112" Stretch="Uniform" /></Border><TextBlock Text="{Binding Title}" Foreground="{StaticResource Ink}" FontSize="12" Margin="2,9,0,3" /><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="10" Margin="2,0,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="HistoryEmpty" Grid.Row="1" Text="{ui:Tr '尚無截圖'}" Foreground="{StaticResource Muted}" FontSize="12" TextAlignment="Center" Margin="10,38" VerticalAlignment="Top" />
          </Grid>
        </Border>
      </Grid>
      <Grid Grid.Row="1" x:Name="CompactPanel" Margin="22,18,22,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Button Click="CaptureClick" Style="{StaticResource Primary}" Height="54" Margin="0,0,6,0"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE722;" FontFamily="Segoe Fluent Icons" FontSize="20" Foreground="#082722" Margin="0,0,10,0" /><TextBlock Text="{ui:Tr '框選截圖'}" FontSize="15" Foreground="#082722" /></StackPanel></Button>
        <Button Grid.Column="1" Click="RecordClick" Height="54" Margin="6,0,0,0" Background="{StaticResource Raised}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" FontFamily="Segoe Fluent Icons" FontSize="20" Margin="0,0,10,0" /><TextBlock Text="{ui:Tr '螢幕錄影'}" FontSize="15" /></StackPanel></Button>
        <TextBlock Grid.Row="1" x:Name="CompactHotkeyHint" Text="Ctrl + Alt + S" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,9,0,0" />
        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="{ui:Tr '長截圖'}" Click="ScrollClick" Padding="9,8" Margin="0,0,3,0" />
          <Button Content="{ui:Tr '開啟圖片'}" Click="OpenClick" Padding="9,8" Margin="0,0,3,0" />
          <Button x:Name="ExpandButton" Content="{ui:Tr '編輯器'}" Click="ExpandClick" Padding="9,8" Margin="0,0,3,0" />
          <Button Click="SettingsClick" ToolTip="{ui:Tr '設定'}" Padding="10,8"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="16" /></Button>
        </StackPanel>
      </Grid>
      <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Background="#101723"><DockPanel Margin="18,0"><TextBlock DockPanel.Dock="Right" x:Name="ImageInfo" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" /><TextBlock x:Name="StatusText" Text="{ui:Tr '就緒'}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" /></DockPanel></Border>
    </Grid>
  </Border>
</Window>
