<Project Sdk="Microsoft.NET.Sdk">
  <!--
    One Avalonia code base for both desktops.
      net10.0                      Linux (X11, and Wayland through XWayland + xdg-desktop-portal)
      net10.0-windows10.0.19041.0  Windows 10/11 (WinRT OCR, Windows.Graphics.Capture, Media Foundation)
    Platform code lives under Platform/Windows and Platform/Linux. Windows-only files are compiled
    for the Windows target only; Linux-only files are compiled for net10.0 only.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StartupObject>SnipFlow.App</StartupObject>
    <ApplicationIcon>Assets/SnipFlow-v3.ico</ApplicationIcon>
    <Version>0.8.3</Version>
    <AssemblyName>SnipFlow</AssemblyName>
    <RootNamespace>SnipFlow</RootNamespace>
    <Product>SnipFlow</Product>
    <Description>SnipFlow 快剪 · 截圖與標註</Description>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
    <Platform>x64</Platform>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>
  <!--
    VideoLAN.LibVLC.Windows copies every VLC plugin (about 103 MB) unless this item lists what to copy
    (paths relative to the package's build\x64 folder, '*' escaped as %2A). The video editor preview only
    plays local MP4 (H.264/HEVC + AAC) through video callbacks, so it needs (about 26 MB):
      libvlc.dll, libvlccore.dll                   the engine
      access\libfilesystem_plugin                  file:// input
      demux\libmp4_plugin                          MP4/MOV demuxer
      codec\libavcodec_plugin                      software H.264/HEVC/AAC decoding (FFmpeg)
      packetizer\*                                 H.264/HEVC/AAC packetizers used between demuxer and decoder
      video_output\libvmem_plugin                  the memory video output behind SetVideoCallbacks
      video_chroma\*                               I420/NV12 to RV32 conversion and scaling (swscale)
      audio_output\libmmdevice/wasapi/directsound  default Windows audio output, with DirectSound as fallback
      audio_filter\*, audio_mixer\*                format conversion, resampling, channel mixing and volume
      logger\*                                     libvlc log handling
    Not copied: hardware decoders (d3d11va/dxva2 are useless with video callbacks), other demuxers, codecs,
    network access, Lua, HRTFs, subtitles, visualizations, stream output and renderers.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <VlcWindowsX64IncludeFiles Include="libvlc.dll;libvlccore.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\access\libfilesystem_plugin.dll;plugins\demux\libmp4_plugin.dll;plugins\codec\libavcodec_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\packetizer\%2A;plugins\video_output\libvmem_plugin.dll;plugins\video_chroma\%2A" />
    <VlcWindowsX64IncludeFiles Include="plugins\audio_output\libmmdevice_plugin.dll;plugins\audio_output\libwasapi_plugin.dll;plugins\audio_output\libdirectsound_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\audio_filter\%2A;plugins\audio_mixer\%2A;plugins\logger\%2A" />
  </ItemGroup>

  <!-- Platform-specific sources. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows10.0.19041.0'">
    <Compile Remove="Platform/Windows/**" />
    <Compile Remove="**/*.Windows.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <Compile Remove="Platform/Linux/**" />
    <Compile Remove="**/*.Linux.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="bin/**;obj/**;tests/**" />
    <AvaloniaResource Include="Assets/SnipFlow-v3.png" />
    <AvaloniaResource Include="Assets/SnipFlow-v3.ico" />
    <Content Include="Assets/SnipFlow-v3.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/SnipFlow-v3.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/SnipFlow-v3-512.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="update-source.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="update-source.json" LogicalName="SnipFlow.update-source.json" />
    <Content Include="../licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
