<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <StartupObject>SnipFlow.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/SnipFlow-v3.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <AssemblyName>SnipFlow</AssemblyName>
    <Product>SnipFlow</Product>
    <Description>SnipFlow 快剪 · 截圖與標註</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF owns the UI and DPI manifest. WinForms is used only for NotifyIcon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="ScreenRecorderLib" Version="7.0.1" />
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <Content Include="update-source.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="update-source.json" LogicalName="SnipFlow.update-source.json" />
    <Resource Include="Assets/SnipFlow-v3.png" />
    <Content Include="Assets/SnipFlow-v3.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../licenses/*.txt" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
